# Public API URL (Render)
NEXT_PUBLIC_API_URL=http://localhost:4000/api
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Better Auth
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_URL=http://localhost:3000
# MongoDB Atlas (same database used by Better Auth)
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.example.mongodb.net/gearvault?retryWrites=true&w=majority
# OAuth credentials from Google Cloud Console
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Shared signing key for short-lived API JWTs; must match server JWT_SECRET
JWT_SECRET=replace-with-a-different-long-random-secret

# ImgBB API key (public client-side upload key)
NEXT_PUBLIC_IMGBB_API_KEY=
